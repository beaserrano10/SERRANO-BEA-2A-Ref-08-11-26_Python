import math
import random



# SECTION 4: GENERAL-PURPOSE MATH FUNCTIONS


def section4_menu():
    while True:
        print("\nSECTION 4: GENERAL-PURPOSE MATH FUNCTIONS")
        print("1. Compute ceil, floor, and trunc of a value")
        print("2. Compute a factorial")
        print("3. Compute the hypotenuse of a right triangle")
        print("0. Back to Main Menu")

        choice = input("Enter your choice: ")

        if choice == "1":
            try:
                value = float(input("Enter a number: "))

                print(f"ceil({value})  = {math.ceil(value)}")
                print(f"floor({value}) = {math.floor(value)}")
                print(f"trunc({value})  = {math.trunc(value)}")

            except ValueError:
                print("Invalid input. Please enter a number.")

        elif choice == "2":
            try:
                number = int(input("Enter a non-negative integer: "))

                if number < 0:
                    print("Factorial is only defined for non-negative integers.")
                else:
                    print(f"{number}! = {math.factorial(number)}")

            except ValueError:
                print("Invalid input. Please enter a whole number.")

        elif choice == "3":
            try:
                side_a = float(input("Enter the first side: "))
                side_b = float(input("Enter the second side: "))

                if side_a < 0 or side_b < 0:
                    print("Side lengths cannot be negative.")
                else:
                    hypotenuse = math.hypot(side_a, side_b)
                    print(f"Hypotenuse = {hypotenuse}")

            except ValueError:
                print("Invalid input. Please enter numbers.")

        elif choice == "0":
            break

        else:
            print("Invalid choice. Please select 0-3.")


# SECTION 5: THE RANDOM MODULE


def section5_menu():
